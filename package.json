{
  "name": "brendenbrusberg-com",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:artwork-source": "node --test tests/artwork-catalog.test.mjs",
    "test:artwork-assets": "node --test tests/artwork-assets.test.mjs",
    "test:artwork": "pnpm test:artwork-source && pnpm test:artwork-assets",
    "test:business-days": "node --test tests/business-days.test.mjs",
    "test": "pnpm test:artwork && pnpm test:business-days",
    "audit": "pnpm exec tsc -p tsconfig.tune.json && node scripts/audit-ant-model.mjs",
    "tune": "pnpm exec tsc -p tsconfig.tune.json && node scripts/tune-ant-model.mjs",
    "dig:fast": "pnpm exec tsc -p tsconfig.tune.json && node scripts/fast-forward-digging.mjs",
    "dig:collage": "node scripts/build-fast-dig-collage.mjs",
    "audit:design": "node scripts/audit-design.mjs",
    "flora": "node scripts/measure-flora.mjs",
    "flora:gardens": "node scripts/measure-flora.mjs --gardens",
    "palette:check": "node scripts/palette-lock.mjs --check",
    "portrait:check": "node scripts/build-portrait.mjs --check",
    "soak": "node scripts/soak-webgl.mjs",
    "soak:long": "node scripts/soak-webgl.mjs --minutes 60 --headful",
    "verify": "pnpm test && pnpm flora && pnpm flora:gardens && pnpm palette:check && pnpm portrait:check && (pnpm audit:design --strict || true)"
  },
  "devDependencies": {
    "postcss": "^8.5.15",
    "typescript": "^5.3.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
