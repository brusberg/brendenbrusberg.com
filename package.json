{
  "name": "brendenbrusberg-com",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:artwork-source": "node --test tests/artwork-catalog.test.mjs",
    "test:artwork-assets": "node --test tests/artwork-assets.test.mjs",
    "test:artwork": "pnpm test:artwork-source && pnpm test:artwork-assets",
    "audit": "pnpm exec tsc -p tsconfig.tune.json && node scripts/audit-ant-model.mjs",
    "tune": "pnpm exec tsc -p tsconfig.tune.json && node scripts/tune-ant-model.mjs",
    "dig:fast": "pnpm exec tsc -p tsconfig.tune.json && node scripts/fast-forward-digging.mjs",
    "dig:collage": "node scripts/build-fast-dig-collage.mjs"
  },
  "devDependencies": {
    "postcss": "^8.5.15",
    "typescript": "^5.3.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
